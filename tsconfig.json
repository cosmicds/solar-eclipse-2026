{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "es5",
    "module": "esnext",
    "composite": true,
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "downlevelIteration": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "tslib": ["../node_modules/tslib/tslib.d.ts"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "es6",
      "ES2016.Array.Include"
    ],
    "types": ["node"]
  },
  "include": [
    "plugins/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "src/assets/upath_lo.json",
    "src/assets/upath_lo_ernie_202608.json",
    "src/assets/center_lo_ernie_202608.json",
  ]
}
